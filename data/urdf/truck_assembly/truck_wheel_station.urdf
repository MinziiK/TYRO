<?xml version="1.0"?>
<robot name="truck_wheel_station">

<!-- Base = hub flange; local +Z protrudes bolts (toward mating tire). -->
  <link name="hub_mount">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="75.0"/>
      <inertia ixx="0.8493749966024997" ixy="0.0" ixz="0.0" iyy="0.8493749966024997" iyz="0.0" izz="1.6537499999999998" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.21" length="0.06"/>
      </geometry>
      <material name="steel"><color rgba="0.4 0.4 0.45 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.21" length="0.06"/>
      </geometry>
    </collision>
  </link>

