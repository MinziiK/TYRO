<?xml version="1.0"?>
<robot name="wheel_gripper">
  <!-- Mount frame: parent FANUC tool0 -->
  <link name="wg_base_link">
    <inertial>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
      <mass value="8"/>
      <inertia ixx="0.05" ixy="0" ixz="0" iyy="0.05" iyz="0" izz="0.05"/>
    </inertial>
  </link>
  <link name="wg_chuck">
    <visual>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.12" length="0.08"/>
      </geometry>
      <material name="grey"><color rgba="0.45 0.47 0.50 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.12" length="0.08"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
      <mass value="4.8"/>
      <inertia ixx="0.02" ixy="0" ixz="0" iyy="0.02" iyz="0" izz="0.02"/>
    </inertial>
  </link>
  <joint name="wg_base-chuck" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="wg_base_link"/>
    <child link="wg_chuck"/>
  </joint>
  <link name="wg_pad_0">
    <visual>
      <origin xyz="0 0 0.07" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.04" length="0.14"/>
      </geometry>
      <material name="yellow"><color rgba="0.85 0.70 0.10 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0.07" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.04" length="0.14"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.07" rpy="0 0 0"/>
      <mass value="1.04"/>
      <inertia ixx="0.005" ixy="0" ixz="0" iyy="0.005" iyz="0" izz="0.005"/>
    </inertial>
  </link>
  <joint name="wg_pad_0-joint" type="fixed">
    <origin xyz="0.52 0 0.08" rpy="0 0 0"/>
    <parent link="wg_chuck"/>
    <child link="wg_pad_0"/>
  </joint>
  <link name="wg_pad_1">
    <visual>
      <origin xyz="0 0 0.07" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.04" length="0.14"/>
      </geometry>
      <material name="yellow"><color rgba="0.85 0.70 0.10 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0.07" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.04" length="0.14"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.07" rpy="0 0 0"/>
      <mass value="1.04"/>
      <inertia ixx="0.005" ixy="0" ixz="0" iyy="0.005" iyz="0" izz="0.005"/>
    </inertial>
  </link>
  <joint name="wg_pad_1-joint" type="fixed">
    <origin xyz="-0.26 0.45033321 0.08" rpy="0 0 2.0943951"/>
    <parent link="wg_chuck"/>
    <child link="wg_pad_1"/>
  </joint>
  <link name="wg_pad_2">
    <visual>
      <origin xyz="0 0 0.07" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.04" length="0.14"/>
      </geometry>
      <material name="yellow"><color rgba="0.85 0.70 0.10 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0.07" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.04" length="0.14"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.07" rpy="0 0 0"/>
      <mass value="1.04"/>
      <inertia ixx="0.005" ixy="0" ixz="0" iyy="0.005" iyz="0" izz="0.005"/>
    </inertial>
  </link>
  <joint name="wg_pad_2-joint" type="fixed">
    <origin xyz="-0.26 -0.45033321 0.08" rpy="0 0 4.1887902"/>
    <parent link="wg_chuck"/>
    <child link="wg_pad_2"/>
  </joint>
  <!-- Tool tip: bore contact / grasp anchor (world +Z from tool0 when palm-up) -->
  <link name="wheel_tool_tip">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.001"/>
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
    </inertial>
  </link>
  <joint name="wg_chuck-tip" type="fixed">
    <origin xyz="0 0 0.14" rpy="0 0 0"/>
    <parent link="wg_chuck"/>
    <child link="wheel_tool_tip"/>
  </joint>
</robot>
